# This repository tracks ONLY the website and the Python code.
# Everything is ignored by default; the allowlist below opts things in.
/*
!/.gitignore
!/README.md
!/pyproject.toml
!/requirements.txt
!/web/
!/src/
!/scripts/
!/tests/
# the website at the root (published by GitHub Actions) and its workflow
!/index.html
!/part*.html
!/assets/
!/.nojekyll
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml

# the standalone study page: this one file only (published at /study/, linked from nowhere)
!/web-study/
/web-study/*
!/web-study/index.html

# src/, scripts/, tests/: Python files only (no data, notebooks, shell scripts or fixtures)
/src/**
!/src/**/
!/src/**/*.py
/scripts/**
!/scripts/**/
!/scripts/**/*.py
/tests/**
!/tests/**/
!/tests/**/*.py

# web/: the tool that fills the site's numbers, but not local notes
/web/README.txt

# no markdown anywhere, except the one README at the top
*.md
!/README.md

# build output of the workflow, never commit
/_site/

# never commit: context files, local agent settings, the R8 blind-review answers, secrets
context/
.claude/
**/r8_key.csv
**/c1_review.csv
**/c1_rows/
.env
*.pem

# caches, environments, editors
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
node_modules/
.hf_cache/
.libero/
.idea/
.vscode/
.DS_Store
*.log
